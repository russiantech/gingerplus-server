# ═══════════════════════════════════════════════════════════════
# deploy/config.env — Single source of truth for this deployment.
# Every other script sources this. Only edit THIS file per project.
# ═══════════════════════════════════════════════════════════════

# ─── Identity ───────────────────────────────────────────────────
CPANEL_USER="gingerpl"                # cPanel username
DOMAIN="api.gingerplus.ng"    # Domain as set in cPanel Python Apps
PYTHON_VERSION="3.11"                 # Must match cPanel-assigned version
PORT=8001                             # Unique port per app (8001–8999)
APP_MODULE="index:app"                # ASGI entrypoint (server/index.py re-exports app.main:app)

# ─── Gunicorn Workers ───────────────────────────────────────────
# auto = (2 × CPU_cores) + 1, hard-capped at 4 for shared hosting.
WORKERS="1"             # cPanel has no Redis by default: the in-memory fallback is per-process, so keep 1 worker
                        # (async handles concurrency). Use 2-4 or "auto" ONLY with a shared REDIS_URL.
WORKER_CLASS="uvicorn.workers.UvicornWorker"  # Async ASGI worker
TIMEOUT=30               # Kill worker if silent > N seconds
KEEPALIVE=5              # Seconds to wait for next request on keep-alive
MAX_REQUESTS=1000        # Recycle worker after N requests (memory-leak guard)
MAX_REQUESTS_JITTER=100  # Spread recycling to avoid thundering herd

# ─── Health Check ────────────────────────────────────────────────
HEALTH_PATH="/health"    # GET endpoint that returns 2xx when app is healthy

# ─── CI/CD ─────────────────────────────────────────────────────
GIT_BRANCH="main"        # Branch release.sh pulls from
RUN_TESTS=false          # Run `pytest` before going live
RUN_MIGRATIONS=true      # Run `alembic upgrade head` after pull
