# Specific patterns requested
# ignore any folder named "_" at repo root or nested
_/
_*/

# ignore files whose name end with an underscore followed by one or more digits
# matches examples like: *_0.html, *_1.tsx, *_3.ts, *_0.jsx and folders like name_1/
*_[0-9]*

